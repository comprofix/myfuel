# ---- App (used by docker compose and `npm run dev`) ----
# Postgres password for the bundled database container
POSTGRES_PASSWORD=change-me
# Encrypts stored API keys and signs sessions. Generate with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string
# First-run admin account (only used when no users exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Port the app listens on locally
APP_PORT=8080
# Host port for Postgres (docker-compose.yml); `npm run dev` connects to it
POSTGRES_PORT=5433
# Dev only: read price data from saved JSON files instead of calling the API (saves API calls)
# FIXTURE_DIR=../out/fixtures

# ---- test-api.sh only (the app stores source API keys in the database via Settings) ----
NSW_API_KEY=your-api-key
NSW_API_SECRET=your-api-secret
# NSW_BASIC_AUTH=base64-of-key:secret
